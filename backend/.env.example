DATABASE_URL=postgresql://postgres:password@localhost:5432/hiring_espresso
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://...clerk.accounts.dev/.well-known/jwks.json
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173

# === Job Ingestion ===
# OpenAI key — used by the normalizer to extract skills, YOE, salary, department
OPENAI_API_KEY=sk-...

# Background scheduler on/off switch
INGESTION_ENABLED=true

# How often the scheduler re-runs (hours)
INGESTION_SCHEDULE_HOURS=6

# Jobs per OpenAI batch call (keep ≤ 50 to stay under token limits)
INGESTION_BATCH_SIZE=50

# Seconds between HTTP requests to the same source (politeness delay)
INGESTION_RATE_LIMIT_DELAY=1.0

# Comma-separated Greenhouse board tokens (public, no auth needed)
# e.g. find token at https://boards.greenhouse.io/{token}
GREENHOUSE_BOARD_TOKENS=stripe,shopify,figma,notion,discord,vercel,linear,retool,brex,rippling,scale-ai,huggingface,databricks,snowflake,anthropic,openai,clerk,render,supabase,planetscale

# Comma-separated Lever company slugs (public, no auth needed)
# e.g. find slug at https://jobs.lever.co/{slug}
LEVER_COMPANY_SLUGS=netflix,canva,plaid

# Comma-separated Ashby company slugs (public, no auth needed)
# e.g. find slug at https://jobs.ashbyhq.com/{slug}
ASHBY_COMPANY_SLUGS=notion,vercel,pika,cursor,linear,loom,retool

# === Search Discovery Providers ===
# SearchDiscoveryFetcher queries these APIs to find job posting URLs, then scrapes each page.
# Providers without a key (DuckDuckGo, JinaSearch) are always active.
# All keys below are optional — configure any combination you have access to.

SEARCH_DISCOVERY_ENABLED=true
# Max URLs to scrape per pipeline run (controls cost/time)
SEARCH_DISCOVERY_MAX_URLS=200

# Tavily — https://tavily.com
TAVILY_API_KEY=

# Brave Search — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Exa (neural search) — https://exa.ai
EXA_API_KEY=

# Bing / Azure Cognitive Search — https://azure.microsoft.com/en-us/products/ai-services/bing-search
BING_API_KEY=

# Google Programmable Search Engine — https://programmablesearchengine.google.com
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# Serper (Google SERP) — https://serper.dev
SERPER_API_KEY=

# SerpAPI — https://serpapi.com
SERPAPI_API_KEY=

# SerpStack — https://serpstack.com
SERPSTACK_API_KEY=

# Serply — https://serply.io
SERPLY_API_KEY=

# SearchAPI.io — https://www.searchapi.io
SEARCHAPI_API_KEY=

# Kagi — https://kagi.com/api
KAGI_API_KEY=

# Mojeek — https://www.mojeek.com/services/search/web-search-api/
MOJEEK_API_KEY=

# Jina AI — https://jina.ai (key optional; raises rate limits)
JINA_API_KEY=

# Perplexity (sonar model) — https://www.perplexity.ai/api
PERPLEXITY_API_KEY=

# You.com (YDC) — https://documentation.you.com
YDC_API_KEY=

# Yandex XML Search — https://yandex.com/dev/xml/
YANDEX_USER=
YANDEX_API_KEY=

# SearXNG — self-hosted instance URL, e.g. https://search.example.com
SEARXNG_BASE_URL=

# YaCy — self-hosted P2P instance URL, e.g. http://localhost:8090
YACY_BASE_URL=

# Bocha AI — https://bochaai.com
BOCHA_API_KEY=

# Sogou Open Platform — https://open.sogou.com
SOGOU_API_KEY=

# Firecrawl — https://firecrawl.dev (used as URL scraper, optional)
FIRECRAWL_API_KEY=
